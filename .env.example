# ---- deploy ----
# Note: the Postgres password is the one setting that lives in deploy/.env
# (Compose reads it from there), not this file. It defaults to "hearth".
# The hostname browsers use. "localhost" makes Caddy self-sign; a real domain gets Let's Encrypt.
HEARTH_DOMAIN=localhost

# ---- gateway ----
# Public origin browsers load; must match what Caddy serves.
HEARTH_PUBLIC_URL=https://localhost
# Origin allowed to call the API (CORS + WebSocket check). Normally the same as HEARTH_PUBLIC_URL.
HEARTH_ALLOWED_ORIGIN=https://localhost
# Cookie-signing key. `just setup` fills this with `openssl rand -base64 36`.
HEARTH_SESSION_SECRET=
# Login name for the built-in admin account.
HEARTH_ADMIN_USER=admin
# argon2id hash of the admin password. `just setup` fills this.
HEARTH_ADMIN_PASSWORD_HASH=
# HEARTH_LISTEN_ADDR / HEARTH_GRPC_LISTEN_ADDR / DATABASE_URL / HEARTH_TRUSTED_PROXIES
# are set by deploy/docker-compose.yml for the container; leave them unset here.
# HEARTH_WEB_DIR is set by the image (/app/web).

# ---- data plane (runs on the host) ----
# Identifier this host registers under with the gateway.
HEARTH_HOST_ID=local
# Address the agent's gRPC server listens on. 0.0.0.0 so the gateway container
# can reach it via host.containers.internal; firewall 9091/9092 on a public host.
HEARTH_AGENT_GRPC_LISTEN_ADDR=0.0.0.0:9091
# Address the workspace's gRPC server listens on. 0.0.0.0 so the gateway container
# can reach it via host.containers.internal; firewall 9091/9092 on a public host.
HEARTH_WORKSPACE_GRPC_LISTEN_ADDR=0.0.0.0:9092
# How the gateway container reaches the agent (host.containers.internal is the compose host bridge).
HEARTH_AGENT_ADDR=https://host.containers.internal:9091
# How the gateway container reaches the workspace service.
HEARTH_WORKSPACE_ADDR=https://host.containers.internal:9092
# the host agent dials the gateway's gRPC here (compose publishes 127.0.0.1:9090)
HEARTH_GATEWAY_GRPC_ADDR=https://127.0.0.1:9090
# Podman socket the workspace service drives. `just setup` fills in
# the real path from your $XDG_RUNTIME_DIR; the value below is only an example.
HEARTH_PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# ---- mTLS ----
# Host-relative paths (systemd WorkingDirectory is the repo root). The agent and
# the workspace service read HEARTH_TLS_CA from here; docker-compose.yml overrides
# all three HEARTH_TLS_* for the gateway container with its /certs mount paths.
HEARTH_TLS_CA=deploy/certs/ca.pem
HEARTH_TLS_CERT=deploy/certs/gateway.pem
HEARTH_TLS_KEY=deploy/certs/gateway-key.pem
# Host-relative paths for the agent (systemd WorkingDirectory is the repo root).
HEARTH_AGENT_TLS_CERT=deploy/certs/agent.pem
HEARTH_AGENT_TLS_KEY=deploy/certs/agent-key.pem
# Host-relative paths for the workspace service.
HEARTH_WORKSPACE_TLS_CERT=deploy/certs/workspace.pem
HEARTH_WORKSPACE_TLS_KEY=deploy/certs/workspace-key.pem

# ---- workspace defaults ----
# Base image new workspaces launch from.
HEARTH_WORKSPACE_IMAGE=ghcr.io/dayski-47/hearth-workspace-base:latest
# Podman network workspaces attach to.
HEARTH_WORKSPACE_NETWORK=egress
# CPU quota per workspace, in millicores.
HEARTH_WORKSPACE_CPU=2000
# Memory limit per workspace, in bytes.
HEARTH_WORKSPACE_MEMORY=2147483648
# Max process count per workspace.
HEARTH_WORKSPACE_PIDS=512
# Disk quota per workspace, in bytes.
HEARTH_WORKSPACE_DISK=5368709120
# Idle time before a workspace is paused.
HEARTH_WORKSPACE_IDLE_TIMEOUT=30m
# How long a dropped terminal session is held for reconnect, in seconds
# (1..=3600). Read by the workspace service; defaults to 60 when unset.
# HEARTH_TERMINAL_GRACE_SECONDS=60
# User-namespace mode for workspace containers.
HEARTH_USERNS=keep-id
